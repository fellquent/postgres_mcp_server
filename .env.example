# Copy to .env and fill in real values. Never commit .env.

# Connection string for the READ-ONLY database role.
# Must be the mcp_ro role, never a role that can write.
MCP_DATABASE_URL=postgresql://mcp_ro:CHANGE_ME@localhost:5432/playground

# Maximum rows returned by any single query.
MCP_MAX_ROWS=100

# Server-side query timeout in milliseconds.
MCP_STATEMENT_TIMEOUT_MS=5000

# Schemas the server is allowed to look at.
MCP_ALLOWED_SCHEMAS=["public"]
